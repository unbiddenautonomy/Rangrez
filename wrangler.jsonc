// Cloudflare Workers config for Rangrez. Deploy with: npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rangrez",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "PATTERN_LIBRARY", "class_name": "PatternLibrary" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom", "PatternLibrary"] }
  ],
  "observability": { "enabled": true }
}
